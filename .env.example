# Database (Cloudflare D1 — created via `wrangler d1 create clipper-db`)
# Set database_id in wrangler.toml after creation
DATABASE_URL="./data/clipper.db"

# Auth
JWT_SECRET="replace-with-a-random-string"

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Same client id in both; the NEXT_PUBLIC_ one is served to the browser.
GOOGLE_CLIENT_ID="google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="google-client-id.apps.googleusercontent.com"

# Stripe
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret from `stripe listen --forward-to localhost:3000/api/subscription/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Prices (create in Stripe dashboard: Products -> Add product -> Recurring monthly)
# Premium subscription price id
STRIPE_PRICE_PREMIUM="price_..."
# Super Premium subscription price id
STRIPE_PRICE_SUPER_PREMIUM="price_..."

# Public app URL (domain when deployed, e.g. https://clipper.pages.dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
